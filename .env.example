# ==============================================================================
# Assessment Engine - Environment Configuration Template (.env.example)
# Copy to .env and configure secrets locally. Never commit secrets to git.
# ==============================================================================

# Google Cloud / Vertex AI / Gemini Configuration
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_CLOUD_PROJECT=sub403o4u0q5
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GEMINI_API_KEY=your_gemini_api_key_here

# Model Role Mapping
AI_FAST_MODEL=gemini-3.8-flash
AI_REASONING_MODEL=gemini-4-argon

# Assessment Engine Execution Defaults
ASSESSMENT_DOC_LANG=es
DEFAULT_ASSESSMENT_CURRENCY=EUR
DEFAULT_ASSESSMENT_ISIC=6201

# MCP Server Configuration
MCP_SERVER_PORT=8000
MCP_PROCESS_POOL_WORKERS=4
MCP_JOBS_DB_PATH=working/jobs.db
