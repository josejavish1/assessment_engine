### 2.3. Remediation for `src/assessment_engine/domain/actuarial/downtime_calibrator.py`
Below is the hardened `OperationalTailRiskEngine` implementation with strict non-negative boundary enforcement (`max(0.0, ...)`) so negative or zero telemetry inputs never cause mathematical anomalies or unhandled exceptions.

```python
from dataclasses import dataclass


@dataclass(frozen=True)
class TailRiskDecomposition:
    """
    Immutable value object representing the actuarial decomposition of tail-risk exposure
    into physical acute downtime and latent SLA/throughput corrosion.
    """
    gross_p90_horizon_hours: float
    capped_physical_outage_hours: float
    latent_friction_overflow_hours: float
    hourly_downtime_rate_eur: float
    acute_outage_loss_eur: float
    latent_sla_corrosion_eur: float
    total_reconciled_eal_eur: float


class OperationalTailRiskEngine:
    """
    Calibrates stochastic P90 downtime horizons into realistic physical outage ceilings
    and reclassifies excess degradation hours into SLA penalty and throughput corrosion.
    """

    DEFAULT_MAX_PHYSICAL_OUTAGE_HOURS: float = 21.2

    @classmethod
    def decompose_tail_risk(
        cls,
        p90_annual_downtime_hours: float,
        hourly_downtime_rate_eur: float,
        p50_mttr_hours: float = 4.0,
        max_physical_outage_ceiling_hours: float = DEFAULT_MAX_PHYSICAL_OUTAGE_HOURS,
    ) -> TailRiskDecomposition:
        """
        Safely decomposes gross P90 downtime hours into physical outage hours and latent
        SLA corrosion, enforcing zero-floor boundary conditions on all numeric inputs.
        """
        safe_gross_hours = max(0.0, float(p90_annual_downtime_hours or 0.0))
        safe_hourly_rate = max(0.0, float(hourly_downtime_rate_eur or 0.0))
        safe_mttr = max(0.0, float(p50_mttr_hours or 0.0))
        safe_ceiling = max(1.0, float(max_physical_outage_ceiling_hours or cls.DEFAULT_MAX_PHYSICAL_OUTAGE_HOURS))

        # Dynamic physical ceiling bounded by operational recovery physics
        effective_ceiling = min(safe_ceiling, max(safe_mttr * 3.5, safe_ceiling))
        capped_physical_hours = min(safe_gross_hours, effective_ceiling)
        latent_overflow_hours = max(0.0, safe_gross_hours - capped_physical_hours)

        acute_loss = round(capped_physical_hours * safe_hourly_rate, 2)
        corrosion_loss = round(latent_overflow_hours * safe_hourly_rate, 2)
        total_reconciled_eal = round(acute_loss + corrosion_loss, 2)

        return TailRiskDecomposition(
            gross_p90_horizon_hours=round(safe_gross_hours, 2),
            capped_physical_outage_hours=round(capped_physical_hours, 2),
            latent_friction_overflow_hours=round(latent_overflow_hours, 2),
            hourly_downtime_rate_eur=round(safe_hourly_rate, 2),
            acute_outage_loss_eur=acute_loss,
            latent_sla_corrosion_eur=corrosion_loss,
            total_reconciled_eal_eur=total_reconciled_eal,
        )
```

